+  runtimeVersion: string;
+  ipAddress: string;
+  lastSeenAt: string;
+  registeredAt: string;
+  metrics: EdgeDeviceMetrics;
+  labels: string[];
+};
+
+export type RegistrationKey = {
+  id: string;
