{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": ".process-test-dist",
    "noEmit": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/processes/domain/**/*.ts",
    "src/processes/application/**/*.ts",
    "tests/processes/**/*.ts"
  ]
}
