+function collectRepeatContainerBindings(
+  document: UiDocument,
+  container: UiNode,
+  runtimeScopePrefix: string | undefined,
+  resolveLegacyTag: (path: string) => TagReactiveRef | undefined,
+  output: RuntimePropertyBinding[],
+  definitionStack: Set<string>
