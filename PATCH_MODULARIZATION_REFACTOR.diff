+  function resolveInternal(name: string): UiComponentScriptApi {
+    if (duplicateNames.has(name)) {
+      throw new Error(
+        `Ambiguous internal component name “${name}” in ${definition.name}. Rename internal nodes to unique API names.`
+      );
+    }
