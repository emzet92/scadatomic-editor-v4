+  args: {
+    children: "Button",
+    variant: "secondary",
+    size: "sm",
+  },
+  argTypes: {
+    variant: {
+      control: "select",
+      options: ["primary", "secondary", "ghost", "danger", "text"],
+    },
+    size: {
+      control: "select",
+      options: ["xs", "sm", "md", "icon-xs", "icon-sm", "icon"],
