+function TokenSwatch({ label, token }: { label: string; token: string }) {
+  return (
+    <div className="overflow-hidden rounded-xl border border-[var(--editor-border)] bg-[var(--editor-surface)]">
+      <div className="h-20" style={{ background: `var(${token})` }} />
